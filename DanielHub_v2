local function createToggle(title, description, order)
    local card = Instance.new("Frame")
    card.BackgroundColor3 = C.Card
    card.LayoutOrder = order
    card.Parent = page

    corner(card, 9)
    stroke(card, C.Blue, 1, 0.55)

    local name = label(
        card, title, 11, C.White, Enum.Font.GothamBold
    )
    name.Position = UDim2.new(0, 9, 0, 7)
    name.Size = UDim2.new(1, -48, 0, 19)

    local desc = label(card, description, 8, C.Gray)
    desc.Position = UDim2.new(0, 9, 0, 29)
    desc.Size = UDim2.new(1, -15, 0, 17)

    local toggle = Instance.new("TextButton")
    toggle.Size = UDim2.new(0, 34, 0, 19)
    toggle.Position = UDim2.new(1, -41, 0, 10)
    toggle.BackgroundColor3 = Color3.fromRGB(55, 65, 80)
    toggle.Text = ""
    toggle.Parent = card
    toggle.AutoButtonColor = false

    corner(toggle, 20)

    local circle = Instance.new("Frame")
    circle.Size = UDim2.new(0, 13, 0, 13)
    circle.Position = UDim2.new(0, 3, 0.5, -6)
    circle.BackgroundColor3 = C.White
    circle.Parent = toggle

    corner(circle, 20)

    local enabled = false

    toggle.Activated:Connect(function()
        enabled = not enabled

        TweenService:Create(
            toggle,
            TweenInfo.new(0.2),
            {
                BackgroundColor3 = enabled
                    and C.Blue
                    or Color3.fromRGB(55, 65, 80)
            }
        ):Play()

        TweenService:Create(
            circle,
            TweenInfo.new(0.2),
            {
                Position = enabled
                    and UDim2.new(1, -16, 0.5, -6)
                    or UDim2.new(0, 3, 0.5, -6)
            }
        ):Play()
    end)

    return card
end

