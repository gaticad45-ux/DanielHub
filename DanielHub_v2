    card.Activated:Connect(function()
        local old = card.BackgroundColor3

        TweenService:Create(
            card,
            TweenInfo.new(0.15),
            {BackgroundColor3 = C.Blue}
        ):Play()

        task.delay(0.2, function()
            if card.Parent then
                card.BackgroundColor3 = old
            end
        end)
    end)

    return card
end

