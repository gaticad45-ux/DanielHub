-- TOGGLES VISUALES
local function visualToggle(parent, text, icon)

    local box = new("Frame", {
        Size = UDim2.new(1, -5, 0, 39),
        BackgroundColor3 = ITEM
    }, parent)

    corner(box, 8)
    stroke(box, BLUE, 1)

    new("TextLabel", {
        Size = UDim2.new(1, -48, 1, 0),
        Position = UDim2.fromOffset(7, 0),
        BackgroundTransparency = 1,
        Text = (icon or "◆") .. " " .. text,
        TextColor3 = WHITE,
        TextSize = 10,
        Font = Enum.Font.GothamBold,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 4
    }, box)

    local toggle = new("Frame", {
        Size = UDim2.fromOffset(32, 18),
        Position = UDim2.new(1, -39, 0.5, -9),
        BackgroundColor3 = Color3.fromRGB(50, 60, 75),
        ZIndex = 4
    }, box)

    corner(toggle, 20)

    local dot = new("Frame", {
        Size = UDim2.fromOffset(12, 12),
        Position = UDim2.fromOffset(3, 3),
        BackgroundColor3 = WHITE,
        ZIndex = 5
    }, toggle)

    corner(dot, 20)

    local enabled = false

    local touchButton = new("TextButton", {
        Name = "TouchButton",
        Size = UDim2.fromScale(1, 1),
        Position = UDim2.fromScale(0, 0),
        BackgroundTransparency = 1,
        Text = "",
        AutoButtonColor = false,
        ZIndex = 10
    }, box)

    touchButton.Activated:Connect(function()

        enabled = not enabled

        TweenService:Create(toggle, TweenInfo.new(0.15), {
            BackgroundColor3 = enabled
                and BLUE
                or Color3.fromRGB(50, 60, 75)
        }):Play()

        TweenService:Create(dot, TweenInfo.new(0.15), {
            Position = enabled
                and UDim2.fromOffset(17, 3)
                or UDim2.fromOffset(3, 3)
        }):Play()

    end)

    return box
end

-- CONTROLES DE VELOCIDAD
local function speedControl(parent, title)

    local row = new("Frame", {
        Size = UDim2.new(1, -5, 0, 48),
        BackgroundColor3 = ITEM,
        BorderSizePixel = 0
    }, parent)

    corner(row, 7)
    stroke(row, Color3.fromRGB(30, 70, 105), 1)

    new("TextLabel", {
        Size = UDim2.fromOffset(70, 35),
        Position = UDim2.fromOffset(9, 0),
        BackgroundTransparency = 1,
        Text = title,
        TextColor3 = WHITE,
        TextSize = 11,
        Font = Enum.Font.GothamBold,
        TextXAlignment = Enum.TextXAlignment.Left
    }, row)

    local value = 0

    local function makeArrow(text, x, callback)

        local button = new("TextButton", {
            Size = UDim2.fromOffset(29, 29),
            Position = UDim2.new(0, x, 0.5, -14),
            BackgroundColor3 = Color3.fromRGB(20, 48, 75),
            Text = text,
            TextColor3 = CYAN,
            TextSize = 13,
            Font = Enum.Font.GothamBold,
            AutoButtonColor = false
        }, row)

        corner(button, 6)
        button.Activated:Connect(callback)

        return button
    end

    local number = new("TextLabel", {
        Size = UDim2.fromOffset(42, 29),
        Position = UDim2.new(0, 171, 0.5, -14),
        BackgroundColor3 = Color3.fromRGB(5, 17, 31),
        Text = "0",
        TextColor3 = CYAN,
        TextSize = 12,
        Font = Enum.Font.GothamBold
    }, row)

    corner(number, 6)

    local function change(amount)
        value = math.max(0, value + amount)
        number.Text = tostring(value)
    end

    makeArrow("≪", 75, function()
        change(-50)
    end)

    makeArrow("<", 108, function()
        change(-1)
    end)

    makeArrow(">", 222, function()
        change(1)
    end)

    makeArrow("≫", 255, function()
        change(50)
    end)

    return row
end

