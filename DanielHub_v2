--========================================
-- MOVIMIENTO MANUAL DE VENTANA
-- COMPATIBLE CON MOUSE Y TOUCH
--========================================

local dragging = false
local dragStart
local startPosition
local dragInput

top.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

        dragging = true
        dragStart = input.Position
        startPosition = main.Position

        if input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end
end)

UIS.InputChanged:Connect(function(input)
    if not dragging then return end

    local isMouse = input.UserInputType ==
        Enum.UserInputType.MouseMovement

    local isTouch = dragInput and input == dragInput

    if isMouse or isTouch then
        local delta = input.Position - dragStart

        main.Position = UDim2.new(
            startPosition.X.Scale,
            startPosition.X.Offset + delta.X,
            startPosition.Y.Scale,
            startPosition.Y.Offset + delta.Y
        )
    end
end)

UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input == dragInput then

        dragging = false
        dragInput = nil
    end
end)

--========================================
-- MOVIMIENTO DEL BOTON FLOTANTE
--========================================

local floatingDragging = false
local floatingStart
local floatingPosition
local floatingInput
local floatingMoved = false

floating.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch
        or input.UserInputType == Enum.UserInputType.MouseButton1 then

        floatingDragging = true
        floatingStart = input.Position
        floatingPosition = floating.Position
        floatingMoved = false

        if input.UserInputType == Enum.UserInputType.Touch then
            floatingInput = input
        end
    end
end)

UIS.InputChanged:Connect(function(input)
    if not floatingDragging then return end

    local isMouse = input.UserInputType ==
        Enum.UserInputType.MouseMovement

    local isTouch = floatingInput and input == floatingInput

    if isMouse or isTouch then
        local delta = input.Position - floatingStart

        if delta.Magnitude > 5 then
            floatingMoved = true
        end

        floating.Position = UDim2.new(
            floatingPosition.X.Scale,
            floatingPosition.X.Offset + delta.X,
            floatingPosition.Y.Scale,
            floatingPosition.Y.Offset + delta.Y
        )
    end
end)

UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input == floatingInput then

        floatingDragging = false
        floatingInput = nil
    end
end)

floating.Activated:Connect(function()
    if floatingMoved then
        floatingMoved = false
        return
    end

    main.Visible = true
    floating.Visible = false
end)

