-- ACTUALIZAR LISTA
local function refreshPlayers()

    -- LIMPIAR LISTA ANTERIOR
    for _, child in ipairs(playerList:GetChildren()) do
        if child:IsA("Frame") then
            child:Destroy()
        end
    end

    -- OBTENER JUGADORES ACTUALES
    local currentPlayers = Players:GetPlayers()

    -- ORDENAR POR NOMBRE
    table.sort(currentPlayers, function(a, b)
        return a.Name:lower() < b.Name:lower()
    end)

    local total = #currentPlayers

    playerCount.Text = "Jugadores encontrados: " .. total

    -- MENSAJE SI NO HAY JUGADORES
    if total == 0 then

        local empty = new("Frame", {
            Size = UDim2.new(1, 0, 0, 36),
            BackgroundColor3 = ITEM
        }, playerList)

        corner(empty, 7)

        new("TextLabel", {
            Size = UDim2.fromScale(1, 1),
            BackgroundTransparency = 1,
            Text = "No se encontraron jugadores",
            TextColor3 = GRAY,
            TextSize = 10,
            Font = Enum.Font.Gotham,
            TextXAlignment = Enum.TextXAlignment.Center
        }, empty)

    else

        -- CREAR FILA POR JUGADOR
        for index, target in ipairs(currentPlayers) do

            local row = new("Frame", {
                Name = "Player_" .. index,
                Size = UDim2.new(1, 0, 0, 36),
                BackgroundColor3 = ITEM,
                BorderSizePixel = 0,
                LayoutOrder = index
            }, playerList)

            corner(row, 7)
            stroke(row, Color3.fromRGB(30, 70, 105), 1)

            new("TextLabel", {
                Size = UDim2.new(1, -16, 1, 0),
                Position = UDim2.fromOffset(10, 0),
                BackgroundTransparency = 1,
                Text = "♙   " .. target.Name,
                TextColor3 = WHITE,
                TextSize = 11,
                Font = Enum.Font.GothamBold,
                TextXAlignment = Enum.TextXAlignment.Left
            }, row)

        end
    end

    -- AJUSTAR ALTURA DEL CONTENEDOR
    task.defer(function()

        local height = playerLayout.AbsoluteContentSize.Y

        playerList.Size = UDim2.new(
            1, -5,
            0,
            math.max(36, height)
        )

    end)

    -- ANIMACION DEL BOTON
    refreshButton.Text = "✓   Jugadores actualizados"

    task.delay(1, function()

        if refreshButton and refreshButton.Parent then
            refreshButton.Text = "⟳   Actualizar jugadores"
        end

    end)

end

refreshButton.Activated:Connect(refreshPlayers)

-- ACTUALIZAR AL ABRIR LA SECCION POR PRIMERA VEZ
