        card, "+",
        UDim2.new(0, 27, 0, 22),
        UDim2.new(0.5, 20, 0, 32)
    )

    minus.Activated:Connect(function()
        value = math.max(0, value - 10)
        number.Text = tostring(value)
    end)

    plus.Activated:Connect(function()
        value = value + 10
        number.Text = tostring(value)
    end)

    return card
end

